# Play Friends Backend Environment Configuration
# Copy this file to .env and configure real credentials for deployment

PORT=3000
NODE_ENV=production

# Brevo (Sendinblue) Transactional API Credentials
# Privileged API key must ONLY be set on the server
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@ssgobind.space
BREVO_SENDER_NAME=Play Friends
BREVO_REPLY_TO=playgamefriendes@gmail.com

# Session and Security Secrets
SESSION_SECRET=your_cryptographically_secure_random_session_secret_32_bytes_or_more

# One-time Admin Provisioning (Optional bootstrap password for administrator setup)
ADMIN_EMAIL=ssgobind12@gmail.com
ADMIN_INITIAL_PASSWORD=replace_with_strong_initial_admin_password

# AWS DynamoDB Settings (If deploying with AWS SDK)
AWS_REGION=ap-southeast-2
TABLE_NAME=PlayFriends_Users
